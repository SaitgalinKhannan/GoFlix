# GoFlix configuration. Copy to .env and fill in your values.
# Variables below are read by docker-compose.yml. Internal container paths
# (TORRENTS_DIR etc.) are hardcoded in compose to /app/data and not needed here.

# ---- Host data folder ----
# Bind-mounted into torrent-service (rw) and jellyfin (ro).
# Holds: torrents/, torrent_data/, torrent_states.json. Use an absolute path.
DATA_DIR=./data

# ---- Auth (JWT access/refresh) ----
# Secret used to sign JWTs. Generate one, e.g.: openssl rand -hex 32
JWT_SECRET=
# Credentials the UI signs in with.
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# ---- torrent-service options ----
# Maximum number of torrents downloading at once.
MAX_CONCURRENT_DOWNLOADS=3
# Initial global limits in KiB/s. 0 means unlimited. Runtime changes made in
# the UI are persisted in DATA_DIR/speed_limits.json and take precedence.
DOWNLOAD_RATE_LIMIT_KIB=0
UPLOAD_RATE_LIMIT_KIB=0

# ---- Jellyfin integration ----
# When a torrent completes, torrent-service POSTs to {JELLYFIN_URL}/Library/Refresh.
JELLYFIN_URL=http://jellyfin:8096
# API token from Jellyfin admin → Dashboard → API Keys.
JELLYFIN_TOKEN=
# Optional: the URL Jellyfin advertises to clients.
JELLYFIN_PUBLISHED_URL=

# ---- Docker Compose ports ----
TORRENT_PORT=8081
JELLYFIN_PORT=8096
FRONTEND_PORT=8080

# ---- Cloudflare Tunnel (optional, enables the public HTTPS UI) ----
# Create a tunnel in the dashboard (Zero Trust → Networks → Tunnels), add a
# Public Hostname routed to http://frontend:80, and paste the tunnel token here.
# Leave empty for local dev — the tunnel container just exits, the rest runs.
TUNNEL_TOKEN=
